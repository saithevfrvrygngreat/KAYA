# Server Port (Render injects 10000 automatically)
PORT=10000

# Node Environment
NODE_ENV=production

# MongoDB Atlas Database URI (Include database name e.g. /kaya)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.jv9r8b2.mongodb.net/kaya?retryWrites=true&w=majority

# JWT Authentication Secret (32+ characters secure random string)
JWT_SECRET=kaya_luxury_super_secret_jwt_key_2026_modern_secure
JWT_EXPIRES_IN=7d

# Google Gemini API Key (Optional: for AI Spatial Analysis & Neural Art Generation)
